<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/styles/contact.css">
    <title>Contact</title>
</head>

<body>
    <button class="nav-btn open-btn">
        <i class="fas fa-bars"></i>
    </button>

    <div class="nav">
        <button class="nav-btn close-btn">
            <i class="fas fa-times"></i>
        </button>

        <br><br>

        <div class="content">
            <h1>CONTACT</h1>
            <div class="hours margin">
                <p>MONDAY - FRIDAY</p>
                <p>12:00PM to 9:00PM</p>
                <p>SATURDAY - SUNDAY</p>
                <p>12:00PM to 10:00PM</p>
            </div>

            <div class="contact margin">
                <a href="#">
                    <p class="icon"><i class="fa-solid fa-phone"></i></p>
                    <p><a href="tel:2122607049">Call Now</a></p>
                    <p>922.194.826.39</p>
                    <p>922.194.826.38</p>
                </a>
            </div>

            <div class="address margin">
                <a href="#">
                    <p class="icon"><i class="fas fa-map-marker-alt"></i></p>
                    <p><a href="#">Directions Here</a></p>
                    <p>140 W4 ST | NYC 10012</p>
                </a>
            </div>

            <div class="mail">
                <a href="#">
                    <p class="icon"><i class="fa-solid fa-envelope"></i></p>
                    <p><a href="#">Message Here</a></p>
                    <p>thegreenspoon@gmail.com</p>
                </a>
            </div>
        </div>
    </div>

    <script>
        const open_btn = document.querySelector('.open-btn');
        const close_btn = document.querySelector('.close-btn');
        const nav = document.querySelector('.nav');

        open_btn.addEventListener('click', () => {
            nav.classList.add('visible');
        });

        close_btn.addEventListener('click', () => {
            nav.classList.remove('visible');
        });
    </script>
</body>

</html>