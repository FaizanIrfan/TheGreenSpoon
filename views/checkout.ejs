<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://use.typekit.net/ynj3swd.css">
    <link rel="stylesheet" href="/styles/checkout.css">
</head>

<body>

    <div class="container">
        <a href="/menu"><i class="fa-solid fa-arrow-left"></i> Continue Shopping</a>
        <h2>Your cart</h2>

        <div>
            <div class="left-section">

                <div class="item">
                    <img src="https://via.placeholder.com/80" alt="Creole Soul Chicken">
                    <div class="item-details">
                        <h4>Creole Soul Chicken</h4>
                        <span>$12.00</span>
                    </div>
                    <div class="quantity-control">
                        <button>-</button>
                        <span>1</span>
                        <button>+</button>
                    </div>
                    <i class="fas fa-trash remove-item"></i>
                </div>

                <div class="item">
                    <img src="https://via.placeholder.com/80" alt="Caribbean Jerk-Spiced Seitan">
                    <div class="item-details">
                        <h4>Caribbean Jerk-Spiced Seitan</h4>
                        <span>$10.00 x 3</span>
                    </div>
                    <div class="quantity-control">
                        <button>-</button>
                        <span>3</span>
                        <button>+</button>
                    </div>
                    <i class="fas fa-trash remove-item"></i>
                </div>

                <div class="add-more-items">Add more items</div>
            </div>

            <div class="right-section">
                <div class="pickup-info">
                    <div class="pickup-edit">Edit</div>
                    <div class="pickup-details"><i class="fas fa-map-marker-alt"></i> Pickup: 140 W 4TH ST</div>
                    <div class="time-details"><i class="fas fa-clock"></i> Today at 8:50 PM</div>
                </div>

                <div class="tip-info">
                    <h4>Add a Tip</h4>
                    <div class="tip-buttons">
                        <button>10% <br> $4.20</button>
                        <button class="selected">15% <br> $6.30</button>
                        <button>20% <br> $8.40</button>
                        <button>Other</button>
                    </div>
                </div>

                <input class="coupon-input" type="text" placeholder="Add coupon or gift card">

                <div class="order-summary">
                    <div class="total-line"><span>Subtotal</span><span>$42.00</span></div>
                    <div class="total-line"><span>Estimated taxes (NY, US)</span><span>$3.73</span></div>
                    <div class="total-line"><span>Tip (15%)</span><span>$6.30</span></div>
                    <div class="total-line"><span>Estimated order total</span><span>$52.03</span></div>
                </div>

                <div class="checkout-button">Continue to payment</div>
            </div>
        </div>
    </div>

</body>

</html>