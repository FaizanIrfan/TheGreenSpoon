<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://use.typekit.net/ynj3swd.css">
    <link rel="stylesheet" href="/styles/checkout.css">
    <title>Your Cart</title>
</head>

<body>

    <div class="container">

        <a href="/menu"><i class="fa-solid fa-arrow-left"></i>&nbsp;&nbsp;Continue Shopping</a>

        <h2>Your cart</h2>

        <div>
            <div class="left-section">
                <h3>YOUR ORDER</h3>

                <% cart.forEach(item=> { %>

                    <div class="item">
                        <img src="<%= item.image %>" alt="<%= item.name %>">
                        <div class="item-detail">
                            <div style="line-height: 25px;">
                                <div>
                                    <%= item.name %>
                                </div>
                                <span>$<%= item.price %></span>
                                <div class="quantity-control">
                                    <a href="/subtract?id=<%= item.id %>">-</a>
                                    <span>
                                        <%= item.quantity %>
                                    </span>
                                    <a href="/add?id=<%= item.id %>">+</a>
                                </div>
                            </div>
                            <span>
                                <div>$<%= item.totalPrice %>.00</div>
                                <span>
                                    <a href="/delete?id=<%= item.id %>" style="color: black;"><i
                                            class="fa-solid fa-trash"></i></a>
                                </span>
                            </span>
                        </div>
                    </div>

                    <% }); %>

                        <a href="/menu">
                            <div class="add-more-items">Add more items</div>
                        </a>
            </div>

            <div class="right-section">
                <h3>FETCH YOUR ORDER</h3>
                <div class="pickup-info">
                    <div class="pickup-details"><i class="fas fa-map-marker-alt"></i> Pickup: 39 NORTH 6TH ST</div>
                    <div class="time-details"><i class="fas fa-clock"></i>Within 45 - 50 minutes</div>
                </div>

                <input class="coupon-input" type="text" placeholder="Add coupon or gift card">

                <div class="order-summary">
                    <div class="total-line"><span>Total</span><span>
                            $<%= subTotal.amount %>.00
                        </span></div>
                    <div class="total-line"><span>GST</span><span>$0.00</span></div>
                    <div class="total-line"><span>Estimated order total</span><span>
                            $<%= subTotal.amount %>.00</span></div>
                </div>

                <a href="/billing-details">
                    <div class="checkout-button">Continue to payment</div>
                </a>
            </div>
        </div>
    </div>

</body>

</html>